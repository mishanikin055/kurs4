__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.playwright-mcp/
# Локальные браузерные профили с Windows-путями в имени.
/C:*/
.venv*/
.env
*.dump
image-analysis*.zip
# Веса и локальные данные; маленькие manifests остаются версионируемыми.
detection/models/*/
detection/models/*.part
data/
storage/
reports/detection/
detection/models/.download.lock
~$*

# Классификация: веса, сырые эксперименты и локальные токены.
classification/models/*/
classification/models/*.part
classification/models/.download.lock
reports/classification/
.secrets/

# Аннотаторы: отдельно закреплённые веса и сырые прогоны.
annotation/models/*/
annotation/models/*.part
annotation/models/.download.lock
reports/annotation/

# Производные формы оценки содержат исходные captions и закрытый ключ.
reports/comparisons/annotation-*/expert_*.csv

# Новые результаты упрощённых однопроходных сравнений.
reports/runs/

# Исторический архив: тяжёлые локальные результаты остаются вне Git.
archive/coursework/reports/detection/
archive/coursework/reports/classification/
archive/coursework/reports/annotation/
archive/coursework/reports/runs/
archive/coursework/reports/comparisons/annotation-*/expert_*.csv

# Launcher создаёт .secrets/app.env; этот файл с реальными ключами не коммитить.
# Не копируйте шаблон поверх существующего файла: сохраните его пароли и настройки.
MINIO_ROOT_USER=kurs4
MINIO_ROOT_PASSWORD=REPLACE_WITH_S3_SECRET_HEX
RABBITMQ_DEFAULT_USER=kurs4
RABBITMQ_DEFAULT_PASS=REPLACE_WITH_BROKER_SECRET_HEX
RABBITMQ_DEFAULT_VHOST=kurs4
APP_ELASTICSEARCH_URL=http://elasticsearch:9200
APP_ELASTICSEARCH_INDEX=image-results
# Пустой/default endpoint выбирает локальный MinIO внутри Docker.
# Другой HTTP(S) endpoint выбирает внешний S3 без локального fallback.
# Для внешнего S3 измените следующие пять строк; остальные настройки сохраните.
# Endpoint S3 API без bucket в URL, доступный из контейнеров; localhost не хост.
# Ключам нужны HEAD bucket, PUT/GET объектов; заранее создайте закрытый bucket.
# Регион и ключи возьмите у провайдера; MINIO_* относятся только к локальному S3.
# Значения с долларом/решёткой заключайте в одинарные кавычки dotenv.
# Подробности DNS, TLS, прав и переключения — в OPERATIONS.md.
APP_S3_ENDPOINT_URL=http://s3:9000
APP_S3_ACCESS_KEY=kurs4
APP_S3_SECRET_KEY=REPLACE_WITH_S3_SECRET_HEX
APP_S3_BUCKET=image-analysis
APP_S3_REGION=us-east-1
APP_PENDING_INPUT_DIR=/var/lib/kurs4/pending
APP_BROKER_URL=amqp://kurs4:REPLACE_WITH_BROKER_SECRET_HEX@rabbitmq:5672/kurs4

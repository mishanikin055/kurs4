# Copy to .secrets/app.env and replace passwords locally. Never commit that file.
POSTGRES_USER=kurs4
POSTGRES_DB=kurs4
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
RABBITMQ_DEFAULT_USER=kurs4
RABBITMQ_DEFAULT_PASS=REPLACE_WITH_ANOTHER_RANDOM_HEX
RABBITMQ_DEFAULT_VHOST=kurs4
APP_DATABASE_URL=postgresql+psycopg://kurs4:REPLACE_WITH_RANDOM_HEX@db:5432/kurs4
APP_BROKER_URL=amqp://kurs4:REPLACE_WITH_ANOTHER_RANDOM_HEX@rabbitmq:5672/kurs4
